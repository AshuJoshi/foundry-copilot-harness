{
  "contract_version": 1,
  "schema_dialect": "Restricted JSON Schema vocabulary interpreted by incident_review.py; not a general JSON Schema engine.",
  "definitions": {
    "text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "evidence_row_id", "observed_values", "observation", "relevance"],
      "properties": {
        "id": {"ref": "text"},
        "file": {"type": "string", "enum": ["metrics.csv", "logs.csv", "traces.csv"]},
        "evidence_row_id": {"type": "integer", "minimum": 1},
        "observed_values": {"type": "object", "minProperties": 1, "values": {"type": "string"}},
        "observation": {"ref": "text"},
        "relevance": {"ref": "text"}
      }
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis", "evidence_ids", "assessment"],
      "properties": {
        "hypothesis": {"ref": "text"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"ref": "text"}},
        "assessment": {"ref": "text"}
      }
    },
    "next_test": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "would_change_diagnosis_if"],
      "properties": {"action": {"ref": "text"}, "would_change_diagnosis_if": {"ref": "text"}}
    },
    "mitigation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "risks", "verification_and_rollback"],
      "properties": {
        "action": {"ref": "text"}, "risks": {"ref": "text"},
        "verification_and_rollback": {"ref": "text"}
      }
    },
    "diagnosis": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "case_id", "status", "originating_service", "mechanism", "evidence", "alternatives", "next_test", "mitigation", "limitations"],
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "case_id": {"ref": "text"},
        "status": {"type": "string", "enum": ["supported", "tentative", "insufficient_evidence"]},
        "originating_service": {"type": ["string", "null"]},
        "mechanism": {"ref": "text"},
        "evidence": {"type": "array", "minItems": 3, "items": {"ref": "evidence"}},
        "alternatives": {"type": "array", "minItems": 2, "items": {"ref": "alternative"}},
        "next_test": {"ref": "next_test"},
        "mitigation": {"ref": "mitigation"},
        "limitations": {"type": "array", "minItems": 1, "items": {"ref": "text"}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "case_id", "input_manifest_sha256", "archive_sha256", "independent_sha256", "diagnosis_sha256"],
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "case_id": {"ref": "text"},
        "input_manifest_sha256": {"ref": "hash"},
        "archive_sha256": {"ref": "hash"},
        "independent_sha256": {"ref": "hash"},
        "diagnosis_sha256": {"ref": "hash"}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "claim_pointer", "claim_text", "assessment", "evidence_ids"],
      "properties": {
        "id": {"ref": "text"},
        "category": {"type": "string", "enum": ["contradicted", "unsupported", "overstated", "missing_alternative"]},
        "claim_pointer": {"type": "string", "pattern": "^/"},
        "claim_text": {"ref": "text"},
        "assessment": {"ref": "text"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"ref": "text"}}
      }
    },
    "accepted_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_pointer", "claim_text", "assessment", "evidence_ids"],
      "properties": {
        "claim_pointer": {"type": "string", "pattern": "^/"},
        "claim_text": {"ref": "text"},
        "assessment": {"ref": "text"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"ref": "text"}}
      }
    },
    "critique": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "case_id", "independent_sha256", "diagnosis_sha256", "verdict", "evidence", "findings", "accepted_claims", "next_test", "limitations"],
      "properties": {
        "schema_version": {"type": "integer", "enum": [1]},
        "case_id": {"ref": "text"},
        "independent_sha256": {"ref": "hash"},
        "diagnosis_sha256": {"ref": "hash"},
        "verdict": {"type": "string", "enum": ["agree", "revise", "insufficient_evidence"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"ref": "evidence"}},
        "findings": {"type": "array", "items": {"ref": "finding"}},
        "accepted_claims": {"type": "array", "items": {"ref": "accepted_claim"}},
        "next_test": {"ref": "next_test"},
        "limitations": {"type": "array", "minItems": 1, "items": {"ref": "text"}}
      }
    }
  }
}
